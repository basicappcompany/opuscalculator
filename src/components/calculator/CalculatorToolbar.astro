---
// The actions for a calculator page: Share, Cite, Embed and Use with AI. A compact row that sits in the page header (icons only on a
// phone, so the tool stays on the first screen), each opening our own dialog: a bottom sheet on a phone, a centred card on a
// desktop. "Share result" and "Copy" live on the result card in the widget (they belong with the answer); "Share result" opens the
// same Share dialog. Everything the dialogs say is in the page HTML, so nothing here depends on a script to be readable by a
// person, a crawler or an agent; the script only opens the dialogs, copies, and keeps the AI prompt in step with the inputs.
// Nothing is stored, and nothing is loaded from another host until a visitor clicks a link in the Share dialog.
import type { CalculatorConfig } from '../../lib/types';
import { MCP_SETUP, MCP_URL, aiPrompt, citationFormats, embedPath, embedSnippet, preferredSourceUrl, shareLinks } from '../../lib/toolbar';
import { markdownPath } from '../../lib/markdown';

interface Props {
  config: CalculatorConfig;
}
const { config } = Astro.props;
const url = new URL(`/calculators/${config.slug}/`, Astro.site).href;
const embedUrl = new URL(embedPath(config.slug), Astro.site).href;
const markdownUrl = new URL(markdownPath(config.slug), Astro.site).href;
const citations = citationFormats(config.h1, url, config.lastUpdated, config.slug);
const embedTitle = `${config.h1} (Opus Calculator)`;
const snippet = embedSnippet(embedUrl, embedTitle);
const links = shareLinks(url, config.h1);
const prompt = aiPrompt(config.h1, config.slug, url);

const button =
  'inline-flex h-9 cursor-pointer items-center justify-center gap-2 rounded-md border border-border-strong bg-card px-2.5 text-sm font-medium text-fg transition-colors hover:bg-accent-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:px-3';
const action =
  'inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-md border border-border-strong bg-card px-3 text-sm font-medium text-fg transition-colors hover:bg-accent-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const primary =
  'inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-md bg-accent px-4 text-sm font-medium text-accent-fg transition-colors hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const ghost =
  'inline-flex size-9 cursor-pointer items-center justify-center rounded-md text-muted transition-colors hover:bg-accent-soft hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const dialog =
  'opus-dialog m-auto w-full max-w-lg overflow-hidden rounded-lg border border-border bg-card p-0 text-fg shadow-md backdrop:bg-fg/40 backdrop:backdrop-blur-sm max-sm:mb-0 max-sm:max-w-none max-sm:rounded-b-none';
const field = 'block w-full rounded-md border border-border-strong bg-bg px-3 py-2 text-sm text-fg';
const tab =
  'cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:bg-accent-soft hover:text-fg aria-selected:bg-accent aria-selected:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const label = 'mb-1 block text-sm font-medium';
const icon = {
  width: '16',
  height: '16',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

<div data-toolbar-root role="group" aria-label="Share, cite, embed or use with AI" class="flex shrink-0 flex-wrap items-center gap-2">
  <button type="button" class={button} data-toolbar="share" data-open="share" aria-haspopup="dialog">
    <svg {...icon}>
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    <span class="max-sm:sr-only">Share</span>
  </button>
  <button type="button" class={button} data-toolbar="cite" data-open="cite" aria-haspopup="dialog">
    <svg {...icon}>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <path d="M14 2v6h6"></path>
      <path d="M16 13H8"></path>
      <path d="M16 17H8"></path>
      <path d="M10 9H8"></path>
    </svg>
    <span class="max-sm:sr-only">Cite</span>
  </button>
  <button type="button" class={button} data-toolbar="embed" data-open="embed" aria-haspopup="dialog">
    <svg {...icon}>
      <polyline points="16 18 22 12 16 6"></polyline>
      <polyline points="8 6 2 12 8 18"></polyline>
    </svg>
    <span class="max-sm:sr-only">Embed</span>
  </button>
  <button type="button" class={`${button} border-accent text-accent-strong`} data-toolbar="ai" data-open="ai" aria-haspopup="dialog">
    <svg {...icon}>
      <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path>
      <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"></path>
    </svg>
    <span>Use with AI</span>
  </button>

  <!-- Share -->
  <dialog class={dialog} data-dialog="share" aria-labelledby="share-title" data-url={url} data-title={config.h1}>
    <div class="flex items-start justify-between gap-3 border-b border-border px-5 py-4">
      <div>
        <h2 id="share-title" class="text-lg font-bold" data-share-heading>
          Share this calculator
        </h2>
        <p class="text-sm text-muted" data-share-sub>
          {config.h1}
        </p>
      </div>
      <button type="button" class={ghost} data-close aria-label="Close">
        <svg {...icon}>
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="space-y-4 px-5 py-4">
      <div>
        <label for={`share-url-${config.slug}`} class={label}>
          Share link
        </label>
        <div class="flex gap-2">
          <input id={`share-url-${config.slug}`} readonly value={url} class={field} data-share-url />
          <button type="button" class={primary} data-copy-from={`share-url-${config.slug}`}>
            <span data-label>Copy link</span>
          </button>
        </div>
      </div>
      <div hidden data-share-summary-wrap>
        <label for={`share-summary-${config.slug}`} class={label}>
          Your result
        </label>
        <textarea id={`share-summary-${config.slug}`} readonly rows="3" class={field} data-share-summary></textarea>
        <button type="button" class={`${action} mt-2`} data-copy-from={`share-summary-${config.slug}`}>
          <span data-label>Copy result text</span>
        </button>
      </div>
      <div>
        <p class="mb-2 text-sm font-medium">Share with</p>
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-share-links>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" data-network={l.id} class={`${action} w-full`}>
                {l.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class={`${action} w-full`} data-native-share hidden>
        More sharing options on this device
      </button>
      <p class="text-xs text-muted">These are plain links: nothing is sent to those sites until you choose one.</p>
      <p class="border-t border-border pt-3 text-sm">
        Find this useful?
        <a
          class="font-medium text-accent-strong underline underline-offset-2"
          data-toolbar="preferred"
          href={preferredSourceUrl()}
          target="_blank"
          rel="noopener noreferrer"
        >
          Add Opus Calculator as a preferred source on Google<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
    <p role="status" aria-live="polite" class="sr-only" data-dialog-status></p>
  </dialog>

  <!-- Cite -->
  <dialog class={dialog} data-dialog="cite" aria-labelledby="cite-title">
    <div class="flex items-start justify-between gap-3 border-b border-border px-5 py-4">
      <div>
        <h2 id="cite-title" class="text-lg font-bold">
          Cite this calculator
        </h2>
        <p class="text-sm text-muted">Pick a style, then copy. Dated by when this page was last updated.</p>
      </div>
      <button type="button" class={ghost} data-close aria-label="Close">
        <svg {...icon}>
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="space-y-3 px-5 py-4">
      <div role="tablist" aria-label="Citation style" class="flex flex-wrap gap-1" data-tabs>
        {citations.map((c, i) => (
          <button
            type="button"
            role="tab"
            id={`cite-tab-${c.id}`}
            aria-controls={`cite-panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={c.id}
            class={tab}
          >
            {c.label}
          </button>
        ))}
      </div>
      {citations.map((c, i) => (
        <div role="tabpanel" id={`cite-panel-${c.id}`} aria-labelledby={`cite-tab-${c.id}`} hidden={i !== 0} data-panel={c.id}>
          <label for={`cite-text-${c.id}`} class="sr-only">
            {c.label} citation
          </label>
          <textarea id={`cite-text-${c.id}`} readonly rows={c.id === 'bibtex' ? 7 : 4} class={`${field} font-mono`}>{c.text}</textarea>
        </div>
      ))}
      <div class="flex flex-wrap items-center justify-between gap-2">
        <button type="button" class={primary} data-copy-active>
          <span data-label>Copy citation</span>
        </button>
        <p class="text-xs text-muted">Citing your own numbers? Use "Share result" on the calculator.</p>
      </div>
    </div>
    <p role="status" aria-live="polite" class="sr-only" data-dialog-status></p>
  </dialog>

  <!-- Embed -->
  <dialog class={dialog} data-dialog="embed" aria-labelledby="embed-title" data-embed-url={embedUrl} data-embed-title={embedTitle}>
    <div class="flex items-start justify-between gap-3 border-b border-border px-5 py-4">
      <div>
        <h2 id="embed-title" class="text-lg font-bold">
          Embed this calculator
        </h2>
        <p class="text-sm text-muted">Show it on your own page. It links back here and is not indexed by search engines.</p>
      </div>
      <button type="button" class={ghost} data-close aria-label="Close">
        <svg {...icon}>
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="space-y-4 px-5 py-4">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for={`embed-width-${config.slug}`} class={label}>
            Embed width
          </label>
          <select id={`embed-width-${config.slug}`} class={field} data-embed-width>
            <option value="100%">Fill the space (recommended)</option>
            <option value="480">480 wide</option>
            <option value="640">640 wide</option>
            <option value="800">800 wide</option>
          </select>
        </div>
        <div>
          <label for={`embed-height-${config.slug}`} class={label}>
            Embed height
          </label>
          <select id={`embed-height-${config.slug}`} class={field} data-embed-height>
            <option value="560">Short (560)</option>
            <option value="640" selected>
              Standard (640)
            </option>
            <option value="760">Tall (760)</option>
            <option value="900">Extra tall (900)</option>
          </select>
        </div>
      </div>
      <div>
        <label for={`embed-code-${config.slug}`} class={label}>
          Paste this on your page
        </label>
        <textarea id={`embed-code-${config.slug}`} readonly rows="4" class={`${field} font-mono`} data-embed-code>{snippet}</textarea>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class={primary} data-copy-from={`embed-code-${config.slug}`}>
          <span data-label>Copy embed code</span>
        </button>
        <a href={embedUrl} target="_blank" rel="noopener" class={action}>
          Preview the embedded copy<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <p role="status" aria-live="polite" class="sr-only" data-dialog-status></p>
  </dialog>

  <!-- Use with AI -->
  <dialog class={`${dialog} sm:max-w-2xl`} data-dialog="ai" aria-labelledby="ai-title" data-slug={config.slug} data-title={config.h1} data-page-url={url}>
    <div class="flex items-start justify-between gap-3 border-b border-border px-5 py-4">
      <div>
        <h2 id="ai-title" class="text-lg font-bold">
          Use this calculator with AI
        </h2>
        <p class="text-sm text-muted">An assistant connected to our MCP server runs the same exact calculation as this page and cites it.</p>
      </div>
      <button type="button" class={ghost} data-close aria-label="Close">
        <svg {...icon}>
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="max-h-[70vh] space-y-5 overflow-y-auto px-5 py-4">
      <div>
        <label for={`ai-prompt-${config.slug}`} class={label}>
          1. Ask your assistant
        </label>
        <textarea id={`ai-prompt-${config.slug}`} readonly rows="4" class={field} data-ai-prompt>{prompt}</textarea>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <button type="button" class={primary} data-copy-from={`ai-prompt-${config.slug}`}>
            <span data-label>Copy prompt</span>
          </button>
          <p class="text-xs text-muted" data-ai-note>
            This prompt uses the calculator's default numbers. Change the inputs and it follows.
          </p>
        </div>
      </div>
      <div>
        <p class={label}>2. Connect once</p>
        <p class="mb-2 text-sm text-muted">
          The server is read-only, needs no account and stores nothing. Any client that supports remote MCP servers over HTTP can use it.
        </p>
        <label for={`ai-url-${config.slug}`} class="sr-only">
          MCP server address
        </label>
        <div class="flex gap-2">
          <input id={`ai-url-${config.slug}`} readonly value={MCP_URL} class={`${field} font-mono`} />
          <button type="button" class={action} data-copy-from={`ai-url-${config.slug}`}>
            <span data-label>Copy address</span>
          </button>
        </div>
        <label for={`ai-cmd-${config.slug}`} class="mt-3 block text-sm text-muted">
          Claude Code, one command
        </label>
        <div class="mt-1 flex gap-2">
          <input id={`ai-cmd-${config.slug}`} readonly value={MCP_SETUP.claudeCode} class={`${field} font-mono`} />
          <button type="button" class={action} data-copy-from={`ai-cmd-${config.slug}`}>
            <span data-label>Copy</span>
          </button>
        </div>
        <label for={`ai-json-${config.slug}`} class="mt-3 block text-sm text-muted">
          Clients that read an mcpServers file (key names vary by client; the address is what matters)
        </label>
        <textarea id={`ai-json-${config.slug}`} readonly rows="7" class={`${field} mt-1 font-mono`}>{MCP_SETUP.json}</textarea>
        <button type="button" class={`${action} mt-2`} data-copy-from={`ai-json-${config.slug}`}>
          <span data-label>Copy config</span>
        </button>
      </div>
      <div>
        <p class={label}>3. Or give an agent this page in a machine-readable form</p>
        <ul class="list-disc space-y-1 pl-6 text-sm">
          <li>
            <a class="font-medium text-accent-strong underline underline-offset-2" href={markdownUrl}>
              Markdown copy of this calculator
            </a>
            : inputs, defaults, result, method, FAQ and a citation.
          </li>
          <li>
            <a class="font-medium text-accent-strong underline underline-offset-2" href="/calculators.json">
              Index of every calculator (JSON)
            </a>
          </li>
          <li>
            <a class="font-medium text-accent-strong underline underline-offset-2" href="/llms.txt">
              llms.txt
            </a>
            : what the site is and where everything is.
          </li>
        </ul>
      </div>
    </div>
    <p role="status" aria-live="polite" class="sr-only" data-dialog-status></p>
  </dialog>
</div>

<script>
  import { aiPrompt, changedInputs, embedSnippet, shareLinks } from '../../lib/toolbar';

  const root = document.querySelector<HTMLElement>('[data-toolbar-root]');
  const dialogs = new Map<string, HTMLDialogElement>();
  root?.querySelectorAll<HTMLDialogElement>('dialog[data-dialog]').forEach((d) => dialogs.set(d.dataset.dialog ?? '', d));

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false; // insecure context or blocked permission: the text is selectable in its box
    }
  }

  /** A short confirmation on the button, and once for screen readers. */
  function confirm(dialog: HTMLDialogElement, button: HTMLElement, done: string, message: string) {
    const label = button.querySelector<HTMLElement>('[data-label]');
    const original = label?.textContent ?? '';
    if (label) label.textContent = done;
    const status = dialog.querySelector<HTMLElement>('[data-dialog-status]');
    if (status) status.textContent = message;
    setTimeout(() => {
      if (label) label.textContent = original;
      if (status) status.textContent = '';
    }, 2000);
  }

  function open(name: string) {
    const dialog = dialogs.get(name);
    if (!dialog || dialog.open) return;
    dialog.showModal();
    document.documentElement.classList.add('overflow-hidden');
  }

  dialogs.forEach((dialog) => {
    dialog.addEventListener('close', () => document.documentElement.classList.remove('overflow-hidden'));
    // The wrapper has the padding, so a click that lands on the dialog itself is a click on the dimmed area.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelectorAll<HTMLElement>('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.querySelectorAll<HTMLElement>('[data-copy-from]').forEach((button) => {
      button.addEventListener('click', async () => {
        const box = document.getElementById(button.dataset.copyFrom ?? '') as HTMLInputElement | HTMLTextAreaElement | null;
        if (!box) return;
        box.select();
        if (await copyText(box.value)) confirm(dialog, button, 'Copied', 'Copied to the clipboard');
      });
    });
  });

  root?.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open ?? '')));

  // ---- Share: the page, or (from the widget) the visitor's own result ----
  const share = dialogs.get('share');
  if (share) {
    const urlBox = share.querySelector<HTMLInputElement>('[data-share-url]');
    const heading = share.querySelector<HTMLElement>('[data-share-heading]');
    const sub = share.querySelector<HTMLElement>('[data-share-sub]');
    const summaryWrap = share.querySelector<HTMLElement>('[data-share-summary-wrap]');
    const summary = share.querySelector<HTMLTextAreaElement>('[data-share-summary]');
    const native = share.querySelector<HTMLButtonElement>('[data-native-share]');
    const pageUrl = share.dataset.url ?? location.href;
    const pageTitle = share.dataset.title ?? document.title;
    let current = { url: pageUrl, title: pageTitle, text: '' };

    const show = (next: { url: string; title: string; text?: string; result?: boolean }) => {
      current = { url: next.url, title: next.title, text: next.text ?? '' };
      if (urlBox) urlBox.value = next.url;
      if (heading) heading.textContent = next.result ? 'Share your result' : 'Share this calculator';
      if (sub) sub.textContent = next.result ? 'This link reopens the calculator with your numbers filled in.' : next.title;
      if (summaryWrap) summaryWrap.hidden = !next.result || !next.text;
      if (summary) summary.value = next.text ?? '';
      for (const l of shareLinks(next.url, next.title, next.text ?? '')) {
        const a = share.querySelector<HTMLAnchorElement>(`[data-network="${l.id}"]`);
        if (a) a.href = l.href;
      }
    };

    if (native && typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', async () => {
        try {
          await navigator.share({ title: current.title, url: current.url, ...(current.text ? { text: current.text } : {}) });
        } catch {
          /* the visitor closed the system sheet */
        }
      });
    }
    urlBox?.addEventListener('focus', () => urlBox.select());

    root?.querySelector<HTMLElement>('[data-open="share"]')?.addEventListener('click', () => show({ url: pageUrl, title: pageTitle }));
    // The widget's "Share result" asks this dialog to open with the visitor's link. Cancelling the event tells the widget it was handled.
    window.addEventListener('opus:share', (event) => {
      const detail = (event as CustomEvent<{ url: string; title: string; text?: string }>).detail;
      if (!detail?.url) return;
      event.preventDefault();
      show({ ...detail, result: true });
      open('share');
    });
  }

  // ---- Cite: tabs for the citation styles ----
  const cite = dialogs.get('cite');
  if (cite) {
    const tabs = [...cite.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = cite.querySelector<HTMLElement>(`[data-panel="${t.dataset.tab}"]`);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const next =
          event.key === 'ArrowRight' ? i + 1 : event.key === 'ArrowLeft' ? i - 1 : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
        if (next < 0) return;
        event.preventDefault();
        select(tabs[(next + tabs.length) % tabs.length], true);
      });
    });
    cite.querySelector<HTMLButtonElement>('[data-copy-active]')?.addEventListener('click', async (event) => {
      const active = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      const box = cite.querySelector<HTMLTextAreaElement>(`[data-panel="${active?.dataset.tab}"] textarea`);
      if (box && (await copyText(box.value))) confirm(cite, event.currentTarget as HTMLElement, 'Copied', `${active?.textContent?.trim()} citation copied`);
    });
  }

  // ---- Embed: size options rewrite the snippet ----
  const embed = dialogs.get('embed');
  if (embed) {
    const widthSel = embed.querySelector<HTMLSelectElement>('[data-embed-width]');
    const heightSel = embed.querySelector<HTMLSelectElement>('[data-embed-height]');
    const code = embed.querySelector<HTMLTextAreaElement>('[data-embed-code]');
    const refresh = () => {
      if (!code || !widthSel || !heightSel) return;
      const w = widthSel.value === '100%' ? '100%' : Number(widthSel.value);
      code.value = embedSnippet(embed.dataset.embedUrl ?? '', embed.dataset.embedTitle ?? '', Number(heightSel.value), w);
    };
    widthSel?.addEventListener('change', refresh);
    heightSel?.addEventListener('change', refresh);
  }

  // ---- Use with AI: the prompt carries the visitor's current numbers ----
  const ai = dialogs.get('ai');
  if (ai) {
    const box = ai.querySelector<HTMLTextAreaElement>('[data-ai-prompt]');
    const note = ai.querySelector<HTMLElement>('[data-ai-note]');
    let latest: { values: Record<string, string>; defaults: Record<string, string> } | null = null;
    // The widget announces its inputs (opus:inputs) every time they change.
    window.addEventListener('opus:inputs', (event) => {
      const detail = (event as CustomEvent<{ values: Record<string, string>; defaults: Record<string, string> }>).detail;
      if (detail?.values) latest = detail;
    });
    const refresh = () => {
      if (!box) return;
      const changed = latest ? changedInputs(latest.values, latest.defaults) : {};
      box.value = aiPrompt(ai.dataset.title ?? '', ai.dataset.slug ?? '', ai.dataset.pageUrl ?? location.href, changed);
      if (note)
        note.textContent = Object.keys(changed).length
          ? 'This prompt carries the numbers you entered.'
          : "This prompt uses the calculator's default numbers. Change the inputs and it follows.";
    };
    root?.querySelector<HTMLElement>('[data-open="ai"]')?.addEventListener('click', refresh);
  }
</script>
