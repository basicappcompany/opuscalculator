---
// The toolbar every calculator page shows (plan/PROMPT 19): share the page, cite it, embed it, add the site as a
// preferred source on Google. "Share result" and "Clear all changes" live in the widget because they need its inputs.
// Static HTML: the citation and the embed code are in the page without JavaScript; the script only adds the buttons'
// behaviour (share sheet, copy). Nothing is stored, and nothing is loaded from another host.
import type { CalculatorConfig } from '../../lib/types';
import { citationLines, embedPath, embedSnippet, preferredSourceUrl } from '../../lib/toolbar';

interface Props {
  config: CalculatorConfig;
}
const { config } = Astro.props;
const url = new URL(`/calculators/${config.slug}/`, Astro.site).href;
const embedUrl = new URL(embedPath(config.slug), Astro.site).href;
const cite = citationLines(config.h1, url, config.lastUpdated);
const snippet = embedSnippet(embedUrl, `${config.h1} (Opus Calculator)`);

const button =
  'inline-flex h-9 cursor-pointer items-center justify-center gap-2 rounded-md border border-border-strong bg-card px-3 text-sm font-medium text-fg transition-colors hover:bg-accent-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const panel = 'mt-2 w-full rounded-md border border-border bg-card p-3 text-sm';
const field = 'mt-1 block w-full rounded-md border border-border-strong bg-bg p-2 font-mono text-xs text-fg';
---

<section aria-label="Share, cite and embed this calculator" data-toolbar-root class="mb-5 flex flex-wrap items-start gap-2">
  <button type="button" class={button} data-toolbar="share" data-url={url} data-title={config.h1}>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    <span data-label>Share</span>
  </button>

  <details data-toolbar="cite" class="group open:w-full">
    <summary class={`${button} list-none [&::-webkit-details-marker]:hidden`}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <path d="M14 2v6h6"></path>
        <path d="M16 13H8"></path>
        <path d="M16 17H8"></path>
        <path d="M10 9H8"></path>
      </svg>
      Cite
    </summary>
    <div class={panel}>
      <label for={`cite-apa-${config.slug}`} class="font-medium">
        APA
      </label>
      <textarea id={`cite-apa-${config.slug}`} readonly rows="3" class={field}>{cite.apa}</textarea>
      <label for={`cite-plain-${config.slug}`} class="mt-3 block font-medium">
        Plain text
      </label>
      <textarea id={`cite-plain-${config.slug}`} readonly rows="2" class={field}>{cite.plain}</textarea>
      <button type="button" class={`${button} mt-3`} data-copy-from={`cite-apa-${config.slug}`}>
        <span data-label>Copy APA citation</span>
      </button>
    </div>
  </details>

  <details data-toolbar="embed" class="group open:w-full">
    <summary class={`${button} list-none [&::-webkit-details-marker]:hidden`}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      Embed
    </summary>
    <div class={panel}>
      <label for={`embed-${config.slug}`} class="font-medium">
        Paste this on your page
      </label>
      <textarea id={`embed-${config.slug}`} readonly rows="4" class={field}>{snippet}</textarea>
      <p class="mt-2 text-muted">The embedded calculator links back to this page. It is not indexed by search engines.</p>
      <button type="button" class={`${button} mt-3`} data-copy-from={`embed-${config.slug}`}>
        <span data-label>Copy embed code</span>
      </button>
    </div>
  </details>

  <a class={button} data-toolbar="preferred" href={preferredSourceUrl()} target="_blank" rel="noopener noreferrer">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    Add as a preferred source on Google<span class="sr-only"> (opens in a new tab)</span>
  </a>

  <span role="status" aria-live="polite" class="sr-only" data-toolbar-status></span>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-toolbar-root]');
  const status = root?.querySelector<HTMLElement>('[data-toolbar-status]');

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false; // insecure context or blocked permission: the text is selectable in its box
    }
  }

  /** Shows a short confirmation on the button and tells screen readers once. */
  function confirm(button: HTMLElement, done: string, message: string) {
    const label = button.querySelector<HTMLElement>('[data-label]');
    const original = label?.textContent ?? '';
    if (label) label.textContent = done;
    if (status) status.textContent = message;
    setTimeout(() => {
      if (label) label.textContent = original;
      if (status) status.textContent = '';
    }, 2000);
  }

  root?.querySelector<HTMLButtonElement>('[data-toolbar="share"]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const url = button.dataset.url ?? location.href;
    const title = button.dataset.title ?? document.title;
    if (typeof navigator.share === 'function') {
      try {
        await navigator.share({ title, url });
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return; // the visitor closed the share sheet
      }
    }
    if (await copyText(url)) confirm(button, 'Link copied', 'Link to this calculator copied');
  });

  root?.querySelectorAll<HTMLButtonElement>('[data-copy-from]').forEach((button) => {
    button.addEventListener('click', async () => {
      const box = document.getElementById(button.dataset.copyFrom ?? '') as HTMLTextAreaElement | null;
      if (!box) return;
      box.select();
      if (await copyText(box.value)) confirm(button, 'Copied', 'Copied to the clipboard');
    });
  });
</script>
