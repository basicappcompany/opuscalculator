---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORY_LABELS } from '../lib/categories';
import { getRenderableHubs, hubPathFor } from '../lib/hubs';
import { getCalculatorsByCategory, getPublishableCalculators } from '../lib/registry';
import { MCP_SETUP, MCP_URL } from '../lib/toolbar';

// Only hubs that render are linked (CLAUDE.md rule 6).
const hubs = getRenderableHubs();
// The Tier 1 calculators: the pages each category hub is built around.
const start = getPublishableCalculators(1).sort((a, b) => (a.slug < b.slug ? -1 : 1));
---

<BaseLayout
  title="Opus Calculator: Exact Calculators for People and AI Agents"
  description="Free, exact calculators for money, health, maths and dates, with the formula and sources shown. Use them on the web or connect an AI assistant through MCP."
  path="/"
>
  <section class="mx-auto max-w-3xl py-6 text-center sm:py-10">
    <p class="text-sm font-semibold uppercase tracking-widest text-muted">Free · Exact · Built for people and AI agents</p>
    <h1 class="mt-5 text-4xl leading-tight sm:text-6xl">
      Exact calculators for <em class="text-accent">people and AI agents</em>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      Every answer shows its formula, a worked example and its sources. Use a calculator here, or let your AI assistant run the same one through MCP.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        data-search-open
        class="inline-flex h-12 cursor-pointer items-center gap-2 rounded-md bg-accent px-6 text-base font-semibold text-accent-fg transition-colors hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Search calculators{' '}
        <kbd class="rounded border border-accent-fg/50 px-1.5 text-sm" aria-hidden="true">
          /
        </kbd>
      </button>
      <a
        href="/agents/"
        class="inline-flex h-12 items-center rounded-md border border-border-strong bg-card px-6 text-base font-semibold text-fg hover:bg-accent-soft"
      >
        Connect your AI
      </a>
    </div>
  </section>

  <section aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="mb-4 text-2xl font-bold tracking-tight">
      Browse by category
    </h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {hubs.map((h) => (
        <li>
          <a
            href={hubPathFor(h.category)}
            class="block h-full rounded-lg border border-border border-t-accent bg-card p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
          >
            <span class="block font-display text-2xl text-fg">{CATEGORY_LABELS[h.category]} calculators</span>
            <span class="block text-sm text-muted">
              {getCalculatorsByCategory(h.category).length} {getCalculatorsByCategory(h.category).length === 1 ? 'calculator' : 'calculators'}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {start.length > 0 && (
    <section aria-labelledby="popular-heading" class="mt-12">
      <h2 id="popular-heading" class="mb-4 text-2xl font-bold tracking-tight">
        Popular calculators
      </h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {start.map((c) => (
          <li>
            <a
              href={`/calculators/${c.slug}/`}
              class="flex items-center justify-between rounded-md border border-border bg-card p-4 font-medium text-accent-strong hover:border-accent hover:bg-accent-soft"
            >
              {c.h1}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="agents-heading" class="mt-12 rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8">
    <h2 id="agents-heading" class="text-2xl font-bold tracking-tight">
      For AI assistants and agents
    </h2>
    <p class="mt-2 max-w-3xl text-muted">
      A read-only MCP server runs the same decimal.js functions as these pages, so an assistant returns the exact number and cites the page. No account, no key.
    </p>
    <label for="home-mcp" class="mt-4 block text-sm font-medium">
      MCP server address
    </label>
    <input id="home-mcp" readonly value={MCP_URL} class="mt-1 block w-full max-w-xl rounded-md border border-border-strong bg-bg px-3 py-2 font-mono text-sm" />
    <p class="mt-3 text-sm text-muted">
      Claude Code: <code class="font-mono">{MCP_SETUP.claudeCode}</code>
    </p>
    <p class="mt-3 text-sm">
      <a class="font-medium text-accent-strong underline underline-offset-2" href="/agents/">
        Set-up for other clients, llms.txt and the JSON index
      </a>
    </p>
  </section>
</BaseLayout>
