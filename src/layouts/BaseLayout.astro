---
import '../styles/global.css';
import CurrencySelect from '../components/CurrencySelect.astro';
import SkinPicker from '../components/SkinPicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { CATEGORY_LABELS } from '../lib/categories';
import { getRenderableHubs, hubPathFor } from '../lib/hubs';
import { SITE_NAME } from '../lib/seo';
import { FOOTER_PAGES } from '../lib/static-pages';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. /calculators/bmi-calculator/. The canonical is built from it and the configured site. */
  path: string;
  /** Adds noindex. Unpublished pages 404 and never render, so this is a second layer (CLAUDE.md rule 1). */
  noindex?: boolean;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** Where the first-tab "skip" link goes. Calculator pages skip to the calculator; every other page to the main content. */
  skipTo?: { href: string; label: string };
}
const { title, description, path, noindex = false, ogType = 'website', skipTo = { href: '#main', label: 'Skip to content' } } = Astro.props;
// Self-referencing canonical on the one canonical host (CLAUDE.md rule 7).
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-template.png', Astro.site).href;
// One cookieless Plausible script, only when a domain is configured (Appendix A: PLAUSIBLE_DOMAIN).
// Only hubs that render are linked (CLAUDE.md rule 6).
const hubs = getRenderableHubs();
const plausibleDomain = import.meta.env.PLAUSIBLE_DOMAIN as string | undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Set the saved theme before the CSS paints, so a dark-mode visitor never sees a flash of light. -->
    <script is:inline>
      try {
        var d = document.documentElement;
        var t = localStorage.getItem('opus-theme');
        if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        // Design preview (owner only): any page opened with ?design turns it on, ?design=off turns it off. Nothing changes for a
        // visitor who never uses it. The skins stylesheet is written in here, before first paint, so there is no flash.
        if (location.search.indexOf('design=off') > -1) localStorage.removeItem('opus-design');
        else if (/[?&]design(=|&|$)/.test(location.search)) localStorage.setItem('opus-design', '1');
        if (localStorage.getItem('opus-design') === '1') {
          d.setAttribute('data-design', '1');
          var s = localStorage.getItem('opus-skin');
          var l = localStorage.getItem('opus-layout');
          var n = localStorage.getItem('opus-density');
          if (s) d.setAttribute('data-skin', s);
          if (l && l !== 'standard') d.setAttribute('data-layout', l);
          if (n && n !== 'comfortable') d.setAttribute('data-density', n);
          document.write('<link rel="stylesheet" href="/skins.css">');
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Opus Calculator: free calculators for everyday questions" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a href={skipTo.href} class="skip-link">
      {skipTo.label}
    </a>
    <header class="sticky top-0 z-10 border-b border-border bg-bg/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-fg">
          <span
            aria-hidden="true"
            class="grid size-9 place-items-center rounded-md bg-linear-to-br from-accent to-accent-2 text-lg font-extrabold text-accent-fg shadow-md"
          >
            O
          </span>
          <span class="sr-only sm:not-sr-only">Opus Calculator</span>
        </a>
        <span class="ml-auto hidden text-sm text-muted lg:inline">Free calculators for everyday questions</span>
        <div class="ml-auto flex items-center gap-2 lg:ml-0">
          <CurrencySelect />
          <SkinPicker />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 sm:py-8">
      <slot />
    </main>
    <footer class="mt-12 border-t border-border bg-card">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-muted">
        {hubs.length > 0 && (
          <nav aria-label="Calculator categories" class="mb-3">
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {hubs.map((h) => (
                <li>
                  <a href={hubPathFor(h.category)} class="underline hover:text-accent-strong">
                    {CATEGORY_LABELS[h.category]}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <nav aria-label="About this site" class="mb-3">
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {FOOTER_PAGES.map((p) => (
              <li>
                <a href={p.path} class="underline hover:text-accent-strong">
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <p>Opus Calculator: free calculators for everyday questions.</p>
      </div>
    </footer>
  </body>
</html>
