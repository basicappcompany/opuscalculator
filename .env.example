# Every environment variable the project reads. Names only: never put a real value in this file, and never commit a
# real .env. Cloudflare Pages takes these in Settings > Environment variables (see README "Environment variables").

# Cohort rollout flags (CLAUDE.md rule 5). Cohort 2 and 3 must stay false until the promotion gate allows them.
COHORT_1_PUBLISHED=true
COHORT_2_PUBLISHED=false
COHORT_3_PUBLISHED=false

# Analytics: the cookieless Plausible script is added only when this is set.
PLAUSIBLE_DOMAIN=opuscalculator.com

# Search Console service account JSON, for `npm run indexation` on your own machine only. SECRET: never set it in
# Cloudflare Pages, never commit it, never prefix it with PUBLIC_.
SEARCH_CONSOLE_CREDENTIALS=

# Test builds only: lets a build run with a cohort flag on without the promotion gate. Ignored on CI and Cloudflare.
PROMOTION_GATE_SKIP=

# Anything prefixed PUBLIC_ is copied into the browser bundle and is visible to every visitor. Only non-secret values.
# The URL of the one ad script, once an ad network is chosen (docs/status.html 12.11). Empty means no ad loads.
PUBLIC_AD_SCRIPT_URL=
