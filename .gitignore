# build output
dist/
# generated types
.astro/
# the MCP server bundle and its generated entry (scripts/build-mcp.ts), rebuilt by every npm run build
.mcp/
.mcp-src/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables and anything else that can hold a secret. .env.example is the only one that is committed (names only).
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
*service-account*.json
*-credentials.json
secrets.*
# Claude Code local settings and the local-only key file (the user's global ignore is not enough: a fresh clone has none)
.claude/settings.local.json
.claude/*.local.json

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local-only files (claude-toggle.bat holds an API key)
claude-toggle.bat
*.iml

# Prompt 8: local monitoring output (URLs and traffic numbers), never committed or deployed
indexation.csv
reports/

# Working topic lists taken from a public competitor catalog: kept out of the public repo
plan/private/

# Prompt 17: Playwright output (reports, traces, failure screenshots). Committed baselines live in tests/visual/*-snapshots/.
test-results/
playwright-report/
blob-report/
